<UserControl x:Class="TaskManager.Client.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:TaskManager.Client.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="380" Padding="32"
                Background="{DynamicResource MahApps.Brushes.Control.Background}"
                CornerRadius="8"
                BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{DynamicResource RegisterTitle}"
                           FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

                <TextBlock Text="{DynamicResource Username}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{DynamicResource Username}"
                         Margin="0,0,0,12" FontSize="14" Padding="8"/>

                <TextBlock Text="{DynamicResource Email}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         mah:TextBoxHelper.Watermark="{DynamicResource Email}"
                         Margin="0,0,0,12" FontSize="14" Padding="8"/>

                <TextBlock Text="{DynamicResource Password}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             mah:TextBoxHelper.Watermark="{DynamicResource Password}"
                             Margin="0,0,0,20" FontSize="14" Padding="8"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <Button Content="{DynamicResource Register}"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                        FontSize="14" Padding="0,10"
                        HorizontalAlignment="Stretch"/>

                <mah:ProgressRing IsActive="{Binding IsBusy}"
                                  Width="30" Height="30" Margin="0,12,0,0"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="{DynamicResource HasAccount}" Margin="0,0,4,0"
                               VerticalAlignment="Center"/>
                    <Button Content="{DynamicResource Login}"
                            Command="{Binding GoToLoginCommand}"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
