<UserControl x:Class="TaskManager.Client.Views.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:TaskManager.Client.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и навигация -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource BackToProcesses}"
                        Command="{Binding BackCommand}"
                        Style="{DynamicResource MahApps.Styles.Button.Flat}"
                        Padding="8,4" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding ProcessTitle}"
                           FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="{DynamicResource NewTask}"
                    Command="{Binding NewTaskCommand}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Padding="16,8"/>
        </DockPanel>

        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red"
                   Margin="0,40,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

        <!-- TabControl с задачами -->
        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource TasksTab}">
                <Grid>
                    <!-- Форма создания/редактирования задачи -->
                    <Border Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource MahApps.Brushes.Control.Background}"
                            Padding="20" CornerRadius="6"
                            BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="1"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            MinWidth="450" Margin="0,10,0,0"
                            Panel.ZIndex="10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TaskTitle}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="8" Margin="0,0,0,12"/>

                            <TextBlock Text="{DynamicResource TaskDescription}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="8" Margin="0,0,0,12"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource TaskStatus}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Statuses}"
                                              SelectedItem="{Binding EditStatus}" Padding="8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource TaskPriority}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Priorities}"
                                              SelectedItem="{Binding EditPriority}" Padding="8"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{DynamicResource TaskDueDate}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding EditDueDate}" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource Cancel}"
                                        Command="{Binding CancelEditCommand}"
                                        Margin="0,0,8,0" Padding="16,8"/>
                                <Button Content="{DynamicResource Save}"
                                        Command="{Binding SaveTaskCommand}"
                                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                                        Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Таблица задач (DataGrid) -->
                    <DataGrid ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              Margin="0,4,0,0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource TaskTitle}"
                                                Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="{DynamicResource TaskStatus}"
                                                Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="{DynamicResource TaskPriority}"
                                                Binding="{Binding Priority}" Width="100"/>
                            <DataGridTextColumn Header="{DynamicResource TaskDueDate}"
                                                Binding="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                Width="110"/>
                            <DataGridTemplateColumn Header="" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Edit}"
                                                    Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                                    Padding="6,2" Margin="0,0,4,0"/>
                                            <Button Content="{DynamicResource Delete}"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource MahApps.Styles.Button.Flat}"
                                                    Foreground="Red" Padding="6,2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <mah:ProgressRing IsActive="{Binding IsBusy}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
