<mah:MetroWindow x:Class="TaskManager.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:TaskManager.Client.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="{DynamicResource AppTitle}"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1">

    <mah:MetroWindow.Resources>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель навигации (видна после входа) -->
        <Border Grid.Row="0"
                Background="{DynamicResource MahApps.Brushes.Accent}"
                Padding="12,8"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBlock Text="{DynamicResource AppTitle}"
                           Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Смена языка -->
                    <Button Content="RU" Margin="4,0"
                            Command="{Binding SwitchLanguageCommand}" CommandParameter="ru"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="White" FontSize="12"/>
                    <Button Content="EN" Margin="4,0"
                            Command="{Binding SwitchLanguageCommand}" CommandParameter="en"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="White" FontSize="12"/>

                    <Rectangle Width="1" Fill="White" Opacity="0.4" Margin="8,4"/>

                    <!-- Навигация -->
                    <Button Content="{DynamicResource Processes}" Margin="4,0"
                            Command="{Binding NavigateCommand}" CommandParameter="ProcessListView"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="White"/>
                    <Button Content="{DynamicResource Settings}" Margin="4,0"
                            Command="{Binding NavigateCommand}" CommandParameter="SettingsView"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="White"/>

                    <Rectangle Width="1" Fill="White" Opacity="0.4" Margin="8,4"/>

                    <Button Content="{DynamicResource Logout}" Margin="4,0"
                            Command="{Binding LogoutCommand}"
                            Style="{DynamicResource MahApps.Styles.Button.Flat}"
                            Foreground="White"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Регион для контента (управляется Prism навигацией) -->
        <ContentControl Grid.Row="1" prism:RegionManager.RegionName="ContentRegion"/>
    </Grid>
</mah:MetroWindow>
