<UserControl x:Class="TaskManager.Client.Controls.TaskCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Карточка задачи — переиспользуемый UserControl -->
    <Border Padding="12" Margin="4" CornerRadius="4"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Description}" Opacity="0.6"
                       Margin="0,4,0,6" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource MahApps.Brushes.Accent}"
                        CornerRadius="3" Padding="6,2" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="White"/>
                </Border>
                <Border Background="{DynamicResource MahApps.Brushes.Gray8}"
                        CornerRadius="3" Padding="6,2">
                    <TextBlock Text="{Binding Priority}" FontSize="11"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
