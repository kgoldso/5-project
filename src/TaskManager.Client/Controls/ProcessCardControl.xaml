<UserControl x:Class="TaskManager.Client.Controls.ProcessCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Карточка процесса — переиспользуемый UserControl -->
    <Border Padding="16" Margin="6" CornerRadius="6" Width="280"
            Background="{DynamicResource MahApps.Brushes.Control.Background}"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1"
            Cursor="Hand">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Description}" Opacity="0.6"
                       Margin="0,4,0,8" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
            <TextBlock Opacity="0.5" FontSize="12">
                <Run Text="{Binding TaskCount, Mode=OneWay}"/>
                <Run Text=" "/><Run Text="{DynamicResource Tasks}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
