## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Ww]in32/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Tt]est[Rr]esults/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Header files
*.gch
*.pch

# TLB Files
*.tlb
*.tli
*.tlh

# Build log files
*.log
*.tlog

# Design Time Message compiler id files
*.idb

# Guid-based Visual C++ internal files
*.pdb

# Precompiled Header Build symbols
*.pch

# CLR old style shared library
*.pdb

# Visual C++ Desktop build log
*.ilk

# Visual Studio 2015/2017/2019/2022 build log
*.aps

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Visual Studio Code config
.vscode/

# Rider config
.idea/

# NuGet Packages
*.nupkg
# The NuGet offline cache is still used by some tools
**/[Pp]ackages/*
# Except build/ folder
!**/[Pp]ackages/build/
# Visual Studio Cache
.librarymanager/
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
appsettings.json
!appsettings.Development.json

# SQLite
*.db
*.db-shm
*.db-wal

# EF Core migrations (optional, but usually kept)
# Migrations/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
